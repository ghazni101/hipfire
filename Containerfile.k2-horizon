# K2-Horizon serving container — pre-built binaries on ROCm base.
#
# 40k Q8 KV context: 19 GB model + ~5 GB KV ≈ 24 GB on 24.5 GB usable
# gfx1100. 64k OOM'd (hipMalloc out of memory, 26 MB free at KV alloc).
# Reasoning is uncapped (budget="uncapped") — no think-token cap.
#
# Build:
#   docker build -f Containerfile.k2-horizon -t k2-horizon-serve .
#
# Run:
#   docker run --rm -d \
#     --device /dev/kfd --device /dev/dri \
#     --security-opt seccomp=unconfined \
#     -v /home/ghazni/models:/models:ro \
#     -v k2-horizon-kcache:/var/cache/hipfire \
#     -p 9001:9001 \
#     k2-horizon-serve

FROM docker.io/rocm/dev-ubuntu-24.04:7.2.4

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

ENV HIP_PATH=/opt/rocm \
    HIPFIRE_KERNEL_CACHE=/var/cache/hipfire \
    HIPFIRE_DAEMON_BIN=/opt/hipfire/bin/daemon \
    HIPFIRE_DIR=/root/.hipfire
RUN mkdir -p /var/cache/hipfire /root/.hipfire && chmod 1777 /var/cache/hipfire

# Pre-built binaries from the host (dlopen'd ROCm, no hard link).
# .docker-bin/ is gitignored — populate it before building:
#   cargo build --release && mkdir -p .docker-bin && \
#     cp target/release/daemon target/release/hipfire .docker-bin/
COPY .docker-bin/daemon /opt/hipfire/bin/daemon
COPY .docker-bin/hipfire /usr/local/bin/hipfire

# Config: Q8 KV, 40k context (VRAM-safe for 24.5 GB), port 9001.
RUN mkdir -p /root/.hipfire
COPY <<'EOF' /root/.hipfire/config.toml
schema_version = 1

[reasoning]
# uncapped — no think-token cap; the model reasons until it closes the block.
budget = "uncapped"

[serve]
multi_slot = false

[speculation]
# K2-Horizon is AR-only — spec decode is refused at load. "off" is
# explicit; "on" would be silently ignored.
mtp = "off"

[memory]
kv_cache = "q8"
max_seq = 40960
EOF

# Symlink model into the models directory so /v1/models lists it.
RUN mkdir -p /root/.hipfire/models && \
    ln -sf /models/RAW/IFM/K2-Horizon-MoVA-36B-A4B/K2-Horizon-MoVA-36B-A4B.mq4r \
           /root/.hipfire/models/K2-Horizon-MoVA-36B-A4B.mq4r

VOLUME ["/var/cache/hipfire"]
EXPOSE 9001

ENTRYPOINT ["hipfire"]
# --idle-timeout 0: never unload the model (keep ~24 GB resident).
# Override at `docker run ... hipfire:k2-horizon serve <model> <addr> --idle-timeout N`.
CMD ["serve", "K2-Horizon-MoVA-36B-A4B.mq4r", "0.0.0.0:9001", "--kv-mode", "q8", "--idle-timeout", "0"]
